# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:35025

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/solai_matrimony

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1d

# Default admin account (created by seed)
ADMIN_EMAIL=admin@solaimatrimony.com
ADMIN_PASSWORD=admin123456

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5mb

# Socket
SOCKET_CORS_ORIGIN=http://localhost:4200

